# Defaults need no credentials, internet, or installation. Export variables in
# your shell, or use Node 20.6+: node --env-file=.env server.mjs
PROCUS_MODE=demo
PROCUS_INDEX_MODE=snapshot
PROCUS_INDEX_REFRESH_HOURS=24
# PROCUS_DATA_DIR=.procus/demo

# Live supplier research: set MODE=live and a random private workspace token.
# PROCUS_API_TOKEN=replace-with-a-random-token-at-least-24-characters
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Independent public index refresh needs no API key: INDEX_MODE=live.
# Email stays disabled even with credentials until explicitly enabled.
PROCUS_EMAIL_ENABLED=false
# RESEND_API_KEY=
# PROCUS_EMAIL_FROM=Procurement <rfq@your-verified-domain.example>
